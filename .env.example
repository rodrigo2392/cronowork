# ============================================================
# Cronowork — Variables de entorno (ejemplo)
# Copia este archivo a `.env` y rellena los valores.
#   cp .env.example .env
# El backend (NestJS) carga las variables vía @nestjs/config.
# El frontend (Vite) sólo lee las variables con prefijo VITE_ en build.
# ============================================================

# ----------------------------------------------------------------
# BACKEND  (apps/backend)
# ----------------------------------------------------------------

# Conexión a MongoDB. OBLIGATORIA — el backend no arranca sin ella.
# El código acepta MONGO_URI o MONGODB_URI (se prioriza MONGO_URI).
MONGO_URI=mongodb://localhost:27017/vibe
# MONGODB_URI=mongodb://localhost:27017/vibe

# Secreto para firmar/validar los JWT. OBLIGATORIA — el backend no arranca sin ella.
# Usa una cadena larga y aleatoria (p. ej. `openssl rand -hex 32`).
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Puerto en el que escucha el backend.
# Opcional — por defecto: 3500
PORT=3500

# Caducidad de los JWT (formato de la lib `ms`: 7d, 24h, 60m...).
# Opcional — por defecto: 7d
JWT_EXPIRES_IN=7d

# API Key de OpenAI. Opcional: sólo necesaria para la generación de tareas con IA.
# Si falta, el resto de la app funciona pero las funciones de IA fallan.
OPENAI_API_KEY=sk-...

# Modelo de OpenAI usado para generar tareas.
# Opcional — por defecto: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# URL del frontend, usada para la configuración de CORS.
# Opcional — por defecto: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# URL pública de la app, usada por el módulo MCP y el CORS de WebSockets.
# Opcional — por defecto: https://cronowork.app
APP_URL=http://localhost:5173

# Orígenes permitidos por CORS (lista separada por comas).
# Opcional — si se define, sustituye por completo a la lista por defecto
# (localhost:5173/5750 + FRONTEND_URL + APP_URL).
# CORS_ORIGINS=http://localhost:5173,https://cronowork.app

# ----------------------------------------------------------------
# FRONTEND  (apps/frontend) — variables de build de Vite (prefijo VITE_)
# ----------------------------------------------------------------

# URL base de la API del backend.
# Opcional — por defecto: http://localhost:3500 (dev) / https://cronowork.app/api (prod)
VITE_API_URL=http://localhost:3500

# URL pública de la app en el frontend.
# Opcional — por defecto: http://localhost:5173 (dev) / https://cronowork.app (prod)
VITE_APP_URL=http://localhost:5173
